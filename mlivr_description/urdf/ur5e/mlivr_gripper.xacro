<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="mlivr_gripper" params="prefix">

    <joint name="${prefix}_ee_fixed_joint" type="fixed">
      <parent link="${prefix}_wrist_3_link"/>
      <child link="${prefix}_gripper_link"/>
      <origin xyz="0 0.099 0" rpy="${radians(-90)} 0 0"/>
    </joint>

    <!-- For adding ft sensor in mjcf -->
    <!-- <joint name="${prefix}_ee_sensor_joint" type="revolute">
      <parent link="${prefix}_wrist_3_link"/>
      <child link="${prefix}_gripper_link"/>
      <origin xyz="0 0.099 0" rpy="${radians(-90)} 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="0" upper="0" effort="0" velocity="0"/>
    </joint> -->

    <link name="${prefix}_gripper_link">
      <inertial>
        <mass value="0.5"/>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <inertia ixx="0.0002167" ixy="0" ixz="0" iyy="0.0002167" iyz="0" izz="0.000225"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.03" length="0.05"/>
        </geometry>
        <material name="gray">
          <color rgba="0.5 0.5 0.5 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="0.03" length="0.05"/>
        </geometry>
      </collision>
      <mujoco>
        <site name="${prefix}_ft_site" pos="0 0 0" size="0.01" rgba="1 0 0 1"/>
        <site name="${prefix}_gripper_site" pos="0 0 0.05" size="0.01" rgba="0 1 0 1" group="1"/>
      </mujoco>
    </link>

    <joint name="${prefix}_palm_fixed_joint" type="fixed">
      <parent link="${prefix}_gripper_link"/>
      <child link="${prefix}_gripper"/>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}_palm_link">
    </link>

  </xacro:macro>

</robot>
